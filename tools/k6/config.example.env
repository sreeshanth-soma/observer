# OpenBroadcaster Observer - k6 Load Test Configuration
# Copy this file to config.env and fill in your values.
# config.env is gitignored and will not be committed.

# Base URL of your Observer instance (no trailing slash)
# Port 8080 = Nginx + PHP-FPM (parallel requests, used by run.sh)
# If you're running Observer on a different URL/port, change this.
OB_BASE_URL=http://127.0.0.1:8080

# Admin user credentials (must have manage_media, manage_playlists, manage_timeslots permissions)
OB_USERNAME=admin
OB_PASSWORD=admin

# Player/device credentials for playout sync testing
# This player must exist in your Observer instance
OB_PLAYER_ID=1
OB_PLAYER_PASSWORD=password

# A media ID that already exists in the system (used by the media availability scenario)
# If left empty, setup will create one from the test upload
OB_TEST_MEDIA_ID=

# User ID of the test user (used for scheduling timeslots)
# Defaults to 1 (usually the admin user on a fresh install)
OB_TEST_USER_ID=1
